# PayForge Production Environment Variables
# Copy to .env.production and fill in values

# Database
DB_PASSWORD=

# Redis
REDIS_PASSWORD=

# Rails
SECRET_KEY_BASE=
# Generate with: rails secret

# Encryption
LOCKBOX_MASTER_KEY=
# Generate with: openssl rand -hex 32

# JWT
JWT_SECRET=
# Generate with: openssl rand -hex 32
